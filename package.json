{
  "name": "aus-edu-connect",
  "version": "1.0.0",
  "private": true,
  "description": "AusEdu Connect - Multi-tenant B2B education marketplace for Australian education agencies and providers.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "pnpm install --recursive",
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --filter ./packages/api run build && pnpm --filter ./packages/web run build",
    "build:api": "pnpm --filter ./packages/api run build",
    "build:web": "pnpm --filter ./packages/web run build",
    "db:generate": "prisma generate --project packages/api/prisma",
    "db:migrate": "prisma migrate deploy --project packages/api/prisma",
    "db:migrate:dev": "prisma migrate dev --project packages/api/prisma",
    "db:seed": "prisma db seed --project packages/api/prisma",
    "db:push": "prisma db push --project packages/api/prisma",
    "lint:api": "eslint packages/api/src --ext .ts,.tsx",
    "lint:web": "eslint packages/web/src --ext .ts,.tsx",
    "typecheck:api": "tsc --noEmit -p packages/api/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p packages/web/tsconfig.json"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15"
  }
}

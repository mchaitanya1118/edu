# ============================================================
# AusEdu Connect — Environment Variables Template for Coolify
# Copy or paste these into your Coolify Application > Environment Variables
# ============================================================

# ------------------------------------------------------------
# 1. Database Credentials (PostgreSQL)
# ------------------------------------------------------------
DB_NAME=aus_edu_connect
DB_USER=aus_edu
# IMPORTANT: Generate a strong, secure random password for production
DB_PASSWORD=replace_with_a_secure_database_password_123!

# ------------------------------------------------------------
# 2. JWT Authentication Secrets
# ------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_32_char_secret_key_here!
JWT_REFRESH_SECRET=replace_with_a_random_32_char_refresh_secret!
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ------------------------------------------------------------
# 3. Domain & CORS Configuration
# ------------------------------------------------------------
# Replace with your actual domain or subdomain hosted via Coolify
# e.g., https://aus-edu.yourdomain.com
CORS_ORIGINS=https://aus-edu.yourdomain.com,http://localhost:5173

# Frontend API base URL (defaults to /api which Nginx reverse-proxies directly to the API container)
VITE_API_URL=/api

# ------------------------------------------------------------
# 4. Optional Ports (defaults to 80 for web, 4000 for API)
# ------------------------------------------------------------
WEB_PORT=80
API_PORT=4000

